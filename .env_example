NEXT_PUBLIC_ONEENTRY_URL=https://your-project.oneentry.cloud
NEXT_PUBLIC_ONEENTRY_TOKEN=your-app-token

NEXT_PUBLIC_VERCEL_URL="https://xxx-xxx-xxx.vercel.app/"

# Google OAuth secrets
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Лимит карточек товара на одну страницу каталога (/shop, /shop/category/*, /shop/[handle])
NEXT_PUBLIC_SHOP_PAGE_LIMIT=10

# id OneEntry-продукта, представляющего доставку. Не показывается в списке корзины,
# подмешивается отдельной строкой в итоги, добавляется в orderProducts при создании заказа.
NEXT_PUBLIC_DELIVERY_PRODUCT_ID=33
